{
  "supplier": "ABC",
  "environment": "sandbox",
  "fieldMappings": {
    "accountNumber": "shipTo.number",
    "branchId": "branchNumber",
    "poNumber": "purchaseOrder",
    "jobName": "shipTo.name",
    "delivery.date": "dates.deliveryRequestedFor",
    "delivery.timeCode": "deliveryAppointment.instructionsTypeCode",
    "delivery.fromTime": "deliveryAppointment.fromTime",
    "delivery.toTime": "deliveryAppointment.toTime",
    "delivery.notes": "deliveryAppointment.instructions",
    "delivery.address.line1": "shipTo.address.line1",
    "delivery.address.line2": "shipTo.address.line2",
    "delivery.address.line3": "shipTo.address.line3",
    "delivery.address.city": "shipTo.address.city",
    "delivery.address.state": "shipTo.address.state",
    "delivery.address.postalCode": "shipTo.address.postal",
    "delivery.contact.name": "shipTo.contacts[0].name",
    "delivery.contact.email": "shipTo.contacts[0].email",
    "delivery.contact.phone": "shipTo.contacts[0].phones[0].number"
  },
  "lineItemMappings": {
    "sku": "itemNumber",
    "description": "itemDescription",
    "qty": "orderedQty.value",
    "uom": "orderedQty.uom",
    "price": "unitPrice.value"
  },
  "defaults": {
    "delivery.fromTime": "07:00",
    "delivery.toTime": "17:00",
    "delivery.timeCode": "AT",
    "deliveryAppointment.timeZoneCode": "CT",
    "currency": "USD",
    "typeCode": "SO",
    "deliveryService": "OTG",
    "shipTo.address.country": "USA",
    "shipTo.contacts": [],
    "orderComments": []
  },
  "wrapper": {
    "type": "array"
  },
  "enumMappings": {
    "delivery.method": {
      "Delivery": "OTG",
      "Pickup": "CPU",
      "roofDrop": "OTG"
    },
    "delivery.timeCode": {
      "Anytime": "AT",
      "anytime": "AT",
      "Morning": "AM",
      "Afternoon": "PM",
      "Special": "AT",
      "Exact": "ST",
      "Range": "TR"
    }
  },
  "specialHandlers": {
    "requestId": "generateRequestId"
  },
  "retry": {
    "maxAttempts": 3,
    "initialDelayMs": 1000,
    "maxDelayMs": 5000,
    "backoffMultiplier": 2,
    "retriableErrorPatterns": [
      "Unable to retrieve confirmation",
      "timeout",
      "network",
      "ECONNRESET",
      "ETIMEDOUT",
      "connection",
      "temporarily unavailable"
    ],
    "nonRetriableErrorPatterns": [
      "validation failed",
      "invalid",
      "required",
      "authentication failed",
      "unauthorized",
      "forbidden",
      "not found"
    ]
  }
}

