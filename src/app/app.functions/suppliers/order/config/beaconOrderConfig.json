{
  "supplier": "BEACON",
  "environment": "sandbox",
  "fieldMappings": {
    "accountNumber": "accountId",
    "branchId": "branchId",
    "poNumber": "poNumber",
    "jobName": "jobName",
    "delivery.date": "deliveryDate",
    "delivery.timeCode": "deliveryTimeCode",
    "delivery.address.line1": "deliveryAddress.line1",
    "delivery.address.line2": "deliveryAddress.line2",
    "delivery.address.city": "deliveryAddress.city",
    "delivery.address.state": "deliveryAddress.state",
    "delivery.address.postalCode": "deliveryAddress.postalCode",
    "delivery.contact.name": "deliveryContact.name",
    "delivery.contact.phone": "deliveryContact.phone",
    "delivery.contact.email": "deliveryContact.email",
    "delivery.notes": "deliveryNotes"
  },
  "lineItemMappings": {
    "sku": "itemNumber",
    "description": "description",
    "qty": "quantity",
    "uom": "unitOfMeasure",
    "price": "unitPrice"
  },
  "defaults": {
    "orderType": "STANDARD",
    "currency": "USD",
    "job.checked": false,
    "job.jobNumber": "999",
    "shipping.shippingMethod": "D",
    "pickupTime": "ANYTIME"
  },
  "wrapper": {
    "type": "object"
  },
  "enumMappings": {
    "delivery.method": {
      "Delivery": "DELIVERY",
      "Pickup": "PICKUP",
      "roofDrop": "DELIVERY"
    },
    "delivery.timeCode": {
      "Anytime": "ANYTIME",
      "anytime": "ANYTIME",
      "Morning": "MORNING",
      "Afternoon": "AFTERNOON"
    }
  },
  "retry": {
    "maxAttempts": 3,
    "initialDelayMs": 1000,
    "maxDelayMs": 5000,
    "backoffMultiplier": 2,
    "retriableErrorPatterns": [
      "timeout",
      "network",
      "ECONNRESET",
      "ETIMEDOUT",
      "connection",
      "temporarily unavailable",
      "service unavailable"
    ],
    "nonRetriableErrorPatterns": [
      "validation failed",
      "invalid",
      "required",
      "is required",
      "authentication failed",
      "unauthorized",
      "forbidden",
      "not found",
      "accountid is required"
    ]
  }
}

